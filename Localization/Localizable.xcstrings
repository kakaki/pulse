        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Symbol statt der Werte; es öffnet die Übersicht. Braucht neben der Notch am wenigsten Platz; ein roter Punkt zeigt einen kritischen Wert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One icon instead of the values; it opens the Overview. Takes the least space next to the notch; a red dot means a critical value."
