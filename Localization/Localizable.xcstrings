    "Np. „Google Chrome Helper ×23” z sumą CPU i pamięci. „Zakończ” kończy wtedy wszystkie procesy w grupie, po potwierdzeniu." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z. B. „Google Chrome Helper ×23“ mit summierter CPU und Speicher. „Beenden“ beendet dann nach Rückfrage alle Prozesse der Gruppe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E.g. “Google Chrome Helper ×23” with CPU and memory added up. “Quit” then ends all processes in the group, after asking."
          }
        }
      }
    },
