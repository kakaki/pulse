          "stringUnit" : {
            "state" : "new",
            "value" : "Na baterii i w trybie niskiego zużycia energii Pulse odświeża dane rzadziej (co %1$lld s zamiast co %2$lld s)."
          }
        }
      }
    },
    "Na dysku %@ zostało %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
