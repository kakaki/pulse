    "Parowanie z %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pairing with %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopplung mit %@"
          }
        }
      }
    },
    "Parowanie: włącz opcję na obu komputerach, wybierz „Sparuj z komputerem…” i potwierdź ten sam kod na obu ekranach. Pliki przeciągnij na kartę komputera w panelu Inne komputery albo na ikonę Pulse w pasku menu; trafią do folderu Pobrane." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pairing: turn the option on on both computers, choose “Pair with a computer…” and confirm the same code on both screens. Drag files onto the computer’s card in the Other Computers panel or onto the Pulse icon in the menu bar; they go to the Downloads folder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopplung: Schalte die Option auf beiden Computern ein, wähle „Mit Computer koppeln …“ und bestätige auf beiden Bildschirmen denselben Code. Zieh Dateien auf die Karte des Computers im Bereich „Andere Computer“ oder auf das Pulse-Symbol in der Menüleiste; sie landen im Ordner „Downloads“."
          }
        }
      }
    },
    "Paruj" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pair"
          }
        },
