            "value" : "Pulse Value"
          }
        }
      }
    },
    "Wartość dysku w pasku menu nie zmienia koloru." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Festplattenwert in der Menüleiste ändert nie die Farbe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The disk value in the menu bar never changes colour."
          }
        }
      }
    },
    "Wartość powyżej progu krytycznego (np. CPU ≥ 90%, temperatura ≥ ok. 90°C, krytyczne ciśnienie pamięci) miga w pasku menu." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Wert über der kritischen Schwelle (z. B. CPU ≥ 90 %, Temperatur ≥ ca. 90 °C, kritischer Speicherdruck) blinkt in der Menüleiste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A value above its critical threshold (e.g. CPU ≥ 90%, temperature ≥ about 90°C, critical memory pressure) blinks in the menu bar."
          }
        }
      }
    },
    "Wartość w pasku menu i na kafelku" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wert in der Menüleiste und auf der Kachel"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Value in the menu bar and on the tile"
          }
        }
      }
    },
