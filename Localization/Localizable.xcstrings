    "Wartość powyżej progu krytycznego (np. CPU ≥ 90%, temperatura ≥ ok. 90°C, krytyczne ciśnienie pamięci) miga w pasku menu." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Wert über der kritischen Schwelle (z. B. CPU ≥ 90 %, Temperatur ≥ ca. 90 °C, kritischer Speicherdruck) blinkt in der Menüleiste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A value above its critical threshold (e.g. CPU ≥ 90%, temperature ≥ about 90°C, critical memory pressure) blinks in the menu bar."
          }
        }
      }
    },
