    "Bateria dłużej zachowa pojemność, jeśli nie stoi stale na 100%. Przydatne, gdy MacBook jest prawie zawsze podłączony do zasilacza." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Akku behält seine Kapazität länger, wenn er nicht ständig bei 100 % steht. Praktisch, wenn das MacBook fast immer am Netzteil hängt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The battery keeps its capacity longer if it doesn’t sit at 100% all the time. Useful when the MacBook is almost always plugged in."
          }
        }
      }
    },
