    "macOS nie pozwala odczytać tego folderu. Dostęp nadasz w Ustawieniach systemowych → Prywatność → Pełny dostęp do dysku." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS erlaubt das Lesen dieses Ordners nicht. Zugriff unter Systemeinstellungen → Datenschutz & Sicherheit → Festplattenvollzugriff erteilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS does not allow reading this folder. Grant access in System Settings → Privacy & Security → Full Disk Access."
