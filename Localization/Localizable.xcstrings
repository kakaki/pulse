    "Na baterii i w trybie niskiego zużycia energii Pulse odświeża dane rzadziej (co %lld s zamiast co %lld s)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Batteriebetrieb und im Stromsparmodus aktualisiert Pulse seltener (alle %lld s statt alle %lld s)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On battery and in Low Power Mode Pulse refreshes less often (every %lld s instead of every %lld s)."
          }
        },
