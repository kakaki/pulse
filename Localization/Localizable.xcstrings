    "Gdy macOS chowa Pulse za wycięciem ekranu lub długim menu aplikacji, Pulse ukrywa etykiety i przechodzi na najwęższy styl." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn macOS Pulse hinter der Kamera-Aussparung oder einem langen App-Menü versteckt, blendet Pulse Beschriftungen aus und wechselt zum schmalsten Stil."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When macOS hides Pulse behind the notch or a long app menu, Pulse drops labels and switches to the narrowest style."
          }
        }
      }
    },
    "Gdy macOS zacznie ograniczać wydajność z powodu temperatury (stan „poważny” lub „krytyczny”)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn macOS die Leistung wegen Hitze drosselt (Zustand „ernst“ oder „kritisch“)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When macOS starts throttling performance because of heat (state “serious” or “critical”)."
          }
        }
      }
    },
    "Gdy macOS zgłosi krytyczne ciśnienie pamięci." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn macOS kritischen Speicherdruck meldet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When macOS reports critical memory pressure."
          }
        }
      }
    },
