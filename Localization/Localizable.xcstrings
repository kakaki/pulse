    "Pulse na tym Macu jest starszy niż 1.13 – zaktualizuj go raz ręcznie." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse auf diesem Mac ist älter als 1.13 – einmal manuell aktualisieren."
          }
        },
        "en" : {
